#include <winver.h>

#define VER_MAJOR       1
#define VER_MINOR       0
#define VER_PATCH       0
#define VER_BUILD       0
#define VER_STRING      "1.0.0.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
PRODUCTVERSION  VER_MAJOR,VER_MINOR,VER_PATCH,VER_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RobloxExternal"
            VALUE "FileDescription",  "RobloxExternal client overlay"
            VALUE "FileVersion",      VER_STRING
            VALUE "InternalName",     "jewsploit"
            VALUE "LegalCopyright",   "Open source. Attribution: awaky1337, MiladRx."
            VALUE "OriginalFilename", "jewsploit.exe"
            VALUE "ProductName",      "RobloxExternal"
            VALUE "ProductVersion",   VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
